<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Needed on API 30+ to enumerate other apps' launch activities. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Lets the Settings screen switch the system screensaver. Not grantable in the UI: deploy.sh runs
         `adb shell pm grant com.andrewevmiller.tvlauncher android.permission.WRITE_SECURE_SETTINGS` once. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- Sleep timer. Declared only so `adb shell appops set com.andrewevmiller.tvlauncher SYSTEM_ALERT_WINDOW allow`
         is possible if the TV spike shows that starting SleepDimActivity from the alarm receiver needs it.
         Nothing requests it at run time. The timer itself needs no permission: setAlarmClock is exact-alarm exempt. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Lets the quick settings show whether the TV is online. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".FieldApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FieldLauncher">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <!-- Listed in the app drawer and startable by hand even when HomeAlias is disabled. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The HOME registration lives on an alias so the crash-loop fallback (safety/) can disable just this
          alias to hand Home back to the previous launcher, while MainActivity stays launchable by hand.
          deploy.sh sets this component as the default home: com.andrewevmiller.tvlauncher/.HomeAlias
        -->
        <activity-alias
            android:name=".HomeAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Oxyfield: our dot-field screensaver. Selected via Settings or
             `settings put secure screensaver_components com.andrewevmiller.tvlauncher/.ambient.OxyfieldDreamService`. -->
        <service
            android:name=".ambient.OxyfieldDreamService"
            android:exported="true"
            android:icon="@drawable/banner"
            android:label="Oxyfield"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Sleep timer: the AlarmManager alarm lands here, whatever state the launcher process is in. Only our own
             PendingIntent reaches it. -->
        <receiver
            android:name=".sleep.SleepAlarmReceiver"
            android:exported="false" />

        <!-- Sleep timer: the dimmed Oxyfield screen shown over the app that was playing. Its own task (own affinity,
             singleTask, not in Recents) so it never drags Home to the front; any key closes it. -->
        <activity
            android:name=".sleep.SleepDimActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:taskAffinity="com.andrewevmiller.tvlauncher.sleep"
            android:theme="@style/Theme.FieldLauncher" />
        <!-- Answers the remote's Settings button (the system asks for this panel; nothing else on this TV provides it). -->
        <activity
            android:name=".panel.NotificationPanelActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.FieldLauncher.Panel">
            <intent-filter>
                <action android:name="android.app.action.TOGGLE_NOTIFICATION_HANDLER_PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Lets the launcher read media sessions for the Now playing band. Reads no notifications. -->
        <service
            android:name=".home.data.NowPlayingListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Takes over the Settings and Tuner remote buttons; off until enabled with tools/remote.ps1. -->
        <service
            android:name=".remote.RemoteKeyService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_key_service" />
        </service>
    </application>
</manifest>
