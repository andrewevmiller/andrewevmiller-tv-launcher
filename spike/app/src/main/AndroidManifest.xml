<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
        E1. Declared here, granted (or not) from adb, so ONE install can be tested in three states:
        neither granted / READ_EPG_DATA granted / ACCESS_ALL_EPG_DATA granted (expected to be refused:
        signature|privileged). To the provider "declared but not granted" is the same as "not declared".
    -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission
        android:name="com.android.providers.tv.permission.ACCESS_ALL_EPG_DATA"
        tools:ignore="ProtectedPermissions" />

    <!-- E2 (d): write Settings.Secure screensaver_components. Granted once over adb. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Needed on API 30+ to inspect com.google.android.apps.tv.dreamx and list dream services. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        E3 (sleep timer), method C. Declared so the appop can be flipped from adb:
        adb shell appops set com.andrewevmiller.spike SYSTEM_ALERT_WINDOW allow
        Nothing else is needed: setAlarmClock, dispatchMediaKeyEvent, requestAudioFocus and starting our own
        activity need no manifest permission. (The setExactAndAllowWhileIdle fallback would need
        SCHEDULE_EXACT_ALARM; it is deliberately not declared. If setAlarmClock works it is never used.)
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <!-- The TV provider that serves channels / preview programs / watch-next programs. -->
        <provider android:authorities="android.media.tv" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="Field Spike"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            E3: the near-black dim surface, started from the alarm receiver (methods B and C).
            Its own task affinity so it does not drag the Field Spike task (MainActivity) to the front, which
            would hide whether a background start of a NEW task works. Not in Recents.
        -->
        <activity
            android:name=".SleepDimActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:taskAffinity="com.andrewevmiller.spike.sleep"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- E3: the alarm lands here (not in an activity), as the launcher's real sleep timer will. -->
        <receiver
            android:name=".SleepAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
